PORT=3000
DATABASE_URL=file:./dev.db
JWT_SECRET=replace-this-with-a-long-random-secret
# Maximum JSON request body size accepted by the API.
JSON_BODY_LIMIT=1mb
# Maximum time (milliseconds) to wait for active requests during shutdown.
SHUTDOWN_TIMEOUT_MS=10000
# Set to production when deployed behind HTTPS to enable HSTS.
NODE_ENV=development
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Authentication throttling. Values apply per IP and endpoint.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Optional JSON array for initial admin accounts during seeding:
# ADMIN_SEED_USERS=[{"username":"admin","email":"admin@example.com","name":"Admin","password":"change-me","role":"ADMIN"}]
